{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "561-group-site",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-26",
  // Probes of *.561.group go through the front door, so same-zone Workers and proxied origins answer as they do to the public.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Never reachable under the account's workers.dev subdomain: 561.group only.
  "workers_dev": false,
  "preview_urls": false,
  // public/ is generated by scripts/build.mjs from data/.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "561.group/*", "zone_name": "561.group" },
    { "pattern": "www.561.group/*", "zone_name": "561.group" }
  ],
  // The ActivityPub host runs inside the existing Worker section-services-561-group (the account is at its Worker cap).
  "services": [{ "binding": "ACTIVITYPUB_INSTANCE", "service": "section-services-561-group" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
